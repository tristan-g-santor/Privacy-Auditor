# copy to .env on the server and fill in real values - read by docker compose
POSTGRES_USER=auditor
POSTGRES_PASSWORD=CHANGE_ME_long_random_string
POSTGRES_DB=privacy_audit
CORS_ORIGINS=https://your-frontend-domain.example
MAX_CONCURRENT_SCANS=2
SCAN_TIMEOUT_SECONDS=30
SCAN_RATE_LIMIT=10
SCAN_RATE_WINDOW_SECONDS=600
# 1 behind Azure Container Apps (its ingress adds the real client IP to X-Forwarded-For); 0 with no proxy in front
TRUSTED_PROXY_HOPS=1
